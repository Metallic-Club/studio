                    ],
                    children: [
                        (
                            class: "Script",
                            props: [
                                ("Name", String("MoveBackAndForth")),
                                ("Source", String("-- Moves this platform back and forth between the two docks, forever.\nlocal RunService = game:GetService(\"RunService\")\n\nlocal platform = script.Parent\nlocal middle = platform.Position\nlocal distance = 7        -- TRY: how far it goes each way, in studs\nlocal secondsPerTrip = 7  -- TRY: a smaller number makes it faster\n\nlocal elapsed = 0\nRunService.Heartbeat:Connect(function(dt)\n    elapsed = elapsed + dt\n    local wave = math.sin(elapsed / secondsPerTrip * 2 * math.pi)\n    platform.Position = middle + Vector3.new(0, 0, wave * distance)\nend)\n")),
                            ],
                        ),
                    ],
                ),
                (
                    class: "Part",
                    props: [
                        ("Name", String("SpinningBar")),
                        ("Position", Vector3((x:0.0,y:15.4,z:-449.0))),
                        ("Size", Vector3((x:28.0,y:1.2,z:1.2))),
                        ("Color", Color3((r:180.0,g:184.0,b:191.0))),
                        ("Material", String("Metal")),
                        ("Anchored", Bool(true)),
                    ],
                    children: [
                        (
                            class: "Script",
                            props: [
                                ("Name", String("Spin")),
                                ("Source", String("-- Spins this bar around the middle of the arena. Jump over it!\nlocal RunService = game:GetService(\"RunService\")\n\nlocal bar = script.Parent\nlocal degreesPerSecond = 70  -- TRY: 40 is easy, 120 is hard\n\nlocal angle = 0\nRunService.Heartbeat:Connect(function(dt)\n    angle = (angle + degreesPerSecond * dt) % 360\n    bar.Orientation = Vector3.new(0, angle, 0)\nend)\n")),
                            ],
                        ),
                    ],
                ),
                (
                    class: "Part",
                    props: [
                        ("Name", String("MovingPlatform2")),
                        ("Position", Vector3((x:0.0,y:59.5,z:-671.5))),
                        ("Size", Vector3((x:8.0,y:1.0,z:8.0))),
                        ("Color", Color3((r:180.0,g:184.0,b:191.0))),
                        ("Material", String("Metal")),
                        ("Anchored", Bool(true)),
                    ],
                    children: [
                        (
                            class: "Script",
                            props: [
                                ("Name", String("MoveBackAndForth")),
                                ("Source", String("-- Moves this platform back and forth between the two docks, forever.\nlocal RunService = game:GetService(\"RunService\")\n\nlocal platform = script.Parent\nlocal middle = platform.Position\nlocal distance = 7        -- TRY: how far it goes each way, in studs\nlocal secondsPerTrip = 7  -- TRY: a smaller number makes it faster\n\nlocal elapsed = 0\nRunService.Heartbeat:Connect(function(dt)\n    elapsed = elapsed + dt\n    local wave = math.sin(elapsed / secondsPerTrip * 2 * math.pi)\n    platform.Position = middle + Vector3.new(0, 0, wave * distance)\nend)\n")),
                            ],
                        ),
                    ],
                ),
                (
                    class: "Part",
                    props: [
                        ("Name", String("Finish")),
                        ("Position", Vector3((x:0.0,y:66.2,z:-753.0))),
                        ("Size", Vector3((x:10.0,y:0.4,z:10.0))),
                        ("Color", Color3((r:236.0,g:234.0,b:240.0))),
                        ("Material", String("SmoothPlastic")),
                        ("Anchored", Bool(true)),
                    ],
                    children: [
                        (
                            class: "Script",
                            props: [
                                ("Name", String("FinishLine")),
                                ("Source", String("-- When a player first reaches the finish, tells them how long the run took.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal finishPad = script.Parent\nlocal finished = ReplicatedStorage:WaitForChild(\"Finished\")\nlocal secondsPlayed = 0  -- counts from when the server starts (in M1 that is when you press Play)\nlocal someoneFinished = false  -- only the first finish counts while this server runs\n\nRunService.Heartbeat:Connect(function(dt)\n    secondsPlayed = secondsPlayed + dt\nend)\n\nfinishPad.Touched:Connect(function(hit)\n    local player = Players:GetPlayerFromCharacter(hit.Parent)\n    if player and not someoneFinished then\n        someoneFinished = true\n        finished:FireClient(player, secondsPlayed)\n    end\nend)\n")),
                            ],
                        ),
                    ],
                ),
            ],
