--- The base of every class. Every object knows its class and reports when a property changes.
declare extern type Object with
    --- The name of the object's class, such as "Folder". It cannot be changed.
    read ClassName: string
    --- Fires after one of the object's properties changes, with the property's name.
    Changed: ScriptSignal<string>
    --- Fires after the named property changes.
    function GetPropertyChangedSignal(self, property: string): ScriptSignal<>
    --- Returns true if the object's class is the given class or inherits from it, such as part:IsA("WorldObject").
    function IsA(self, className: string): boolean
end

--- The base of everything in the game tree. An instance has a name and a parent, can be searched, copied and destroyed, and can carry custom attributes.
declare extern type Instance extends Object with
    --- The instance's name. Names do not have to be unique; FindFirstChild returns the first match.
    Name: string
    --- The instance this one sits under, or nil when it is outside the game. Setting it moves the instance.
    Parent: Instance?
    --- Whether the instance is copied by Clone and saved with the game. Turn it off for temporary objects.
    Archivable: boolean
    --- Fires after an instance is placed directly under this one.
    ChildAdded: ScriptSignal<Instance>
    --- Fires after an instance directly under this one is moved away or destroyed.
    ChildRemoved: ScriptSignal<Instance>
    --- Fires after an instance is placed anywhere under this one, at any depth.
    DescendantAdded: ScriptSignal<Instance>
    --- Fires just before an instance anywhere under this one is moved away or destroyed.
    DescendantRemoving: ScriptSignal<Instance>
    --- Fires when this instance or one of its ancestors gets a new parent, with the instance that moved and its new parent (nil when it left the game).
    AncestryChanged: ScriptSignal<Instance, Instance?>
    --- Fires after an attribute is set, changed or removed, with the attribute's name.
    AttributeChanged: ScriptSignal<string>
    --- Fires when the instance is about to be destroyed, while it is still intact.
    Destroying: ScriptSignal<>
    --- Removes the instance and everything under it from the game for good. It cannot be used again afterwards.
    function Destroy(self): ()
    --- Returns a copy of the instance and everything under it, with no parent. Returns nil when Archivable is off; children with Archivable off are left out.
    function Clone(self): Instance?
    --- Returns a list of the instances directly under this one, in order.
    function GetChildren(self): {Instance}
    --- Returns a list of every instance under this one, at any depth, parents before their children.
    function GetDescendants(self): {Instance}
    --- Returns the first child with the given name, or nil. Pass true as the second argument to search every descendant.
    function FindFirstChild(self, name: string, recursive: boolean?): Instance?
    --- Returns the first child whose class is exactly the given class, or nil. Subclasses do not count; use FindFirstChildWhichIsA for that.
    function FindFirstChildOfClass(self, className: string): Instance?
    --- Returns the first child whose class is the given class or inherits from it, or nil. Pass true as the second argument to search every descendant.
    function FindFirstChildWhichIsA(self, className: string, recursive: boolean?): Instance?
    --- Returns the nearest instance above this one with the given name, or nil.
    function FindFirstAncestor(self, name: string): Instance?
    --- Returns true if this instance is somewhere under the given instance.
    function IsDescendantOf(self, ancestor: Instance): boolean
    --- Returns true if the given instance is somewhere under this one.
    function IsAncestorOf(self, descendant: Instance): boolean
    --- Returns the instance's path of names from its service down, separated by dots, such as "Workspace.Map.Door".
    function GetFullName(self): string
    --- Destroys every child of the instance (and everything under them). The instance itself stays.
    function ClearAllChildren(self): ()
    --- Returns the value of the attribute with the given name, or nil when it is not set.
    function GetAttribute(self, name: string): any
    --- Sets an attribute: a custom named value stored on the instance and saved with it. Setting nil removes it. Attributes hold booleans, numbers, strings, vectors, CFrames, colours and enum items, not instances.
    function SetAttribute(self, name: string, value: any): ()
    --- Returns every attribute of the instance as a table of names to values.
    function GetAttributes(self): {[string]: any}
end

--- A signal that scripts fire themselves: one script calls Fire, and every function connected to Event runs with the same arguments. It works between scripts on the same side (server or client).
declare extern type BindableEvent extends Instance with
    --- Fires when Fire is called, with the arguments passed to Fire.
    Event: ScriptSignal<...any>
    --- Fires Event with all the arguments given. Listeners run later in the frame, not inside Fire; when nothing is connected, nothing happens.
    function Fire(self, ...: any): ()
end

--- A function that one script exposes and others call: a script assigns a function to OnInvoke, and Invoke calls it and returns what it returns. It works between scripts on the same side (server or client).
declare extern type BindableFunction extends Instance with
    --- The function Invoke calls. Assign a function to it (or nil to remove it); it receives Invoke's arguments, and what it returns is what Invoke returns. It cannot be read.
    write OnInvoke: ((...any) -> any)?
    --- Calls the function assigned to OnInvoke with all the arguments given and returns its results. The calling script waits while the function runs, even if it yields. If no function is assigned yet, the caller waits until one is; an error in the function is raised in the caller.
    function Invoke(self, ...: any): any
end

