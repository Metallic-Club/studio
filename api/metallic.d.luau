--- One input: a press of a key or mouse button, a finger on the screen, the mouse's movement or the wheel. UserInputService's InputBegan, InputChanged and InputEnded pass one. Each press is a new object that goes from Begin to End and is then destroyed (it stays readable while you hold it), so a table keyed by input objects tracks what is held. Mouse movement and the wheel reuse one object each, updated every frame.
declare extern type InputObject extends Instance with
    --- The key, for keyboard input; Unknown for every other kind.
    read KeyCode: EnumKeyCode
    --- What kind of input this is: a key, a mouse button, mouse movement, the wheel or a touch.
    read UserInputType: EnumUserInputType
    --- Where the input is: Begin, Change, End or Cancel.
    read UserInputState: EnumUserInputState
    --- Where the input is, in physical pixels from the window's top-left corner (X right, Y down): the cursor for keys, mouse buttons and movement, the finger for a touch. For the wheel, Z is how many notches it turned this frame (positive away from the user).
    read Position: Vector3
    --- How far the input moved since the last frame: raw mouse movement for MouseMovement (it keeps coming while the cursor is locked), pixels for a touch. Zero for keys and buttons.
    read Delta: Vector3
    --- Engine bookkeeping: the next held key's input object (see UserInputService.FirstInput).
    read NextInput: InputObject?
end

--- Controls how the scene is lit: the time of day, the sun and moon, the colours of the sky and the ambient light.
declare extern type Lighting extends Instance with
    --- The time of day in hours, which places the sun: 6 is sunrise, 12 is noon, 18 is sunset. Values wrap around the clock instead of stopping at the ends: 25 becomes 1 and -1 becomes 23, so a script can simply add to it to run the day.
    ClockTime: number
    --- ClockTime written as hours, minutes and seconds, such as "14:30:00" (hours 0-23, seconds optional when writing). Setting it sets ClockTime; a text that is not a time is an error.
    TimeOfDay: string
    --- How strong the sunlight is (and the moonlight, at night). 0 turns the sun off; there is no upper limit.
    Brightness: number
    --- Where on Earth the game is, in degrees north of the equator. It sets how high the sun climbs: at 0 it passes straight overhead at noon, further north it stays lower in the south.
    GeographicLatitude: number
    --- The direction from the scene towards the sun, a unit vector set by ClockTime and GeographicLatitude. It points below the horizon at night, when the moon, opposite it, lights the scene.
    read SunDirection: Vector3
    --- Whether the sun, and the moon at night, cast shadows. Each part can still opt out with its own CastShadow. Turning it off saves the cost of drawing the shadows.
    GlobalShadows: boolean
    --- The colour of the sky overhead in the middle of the day. It also tints the light from the sky.
    SkyColor: Color3
    --- The colour of the sky at the horizon in the middle of the day; the sky fades to it from SkyColor.
    HorizonColor: Color3
    --- The light the sky gives outdoors, from above, filling what the sun does not reach. It dims at night and is bluer then.
    OutdoorAmbient: Color3
    --- Light added evenly everywhere, indoors and out, at every time of day: raise it to keep dark places and nights brighter.
    Ambient: Color3
    --- Returns the time of day in minutes since midnight, which is ClockTime times 60.
    function GetMinutesAfterMidnight(self): number
    --- Sets the time of day to this many minutes after midnight. Like ClockTime it wraps around the day, so 1500 is 01:00.
    function SetMinutesAfterMidnight(self, minutes: number): ()
    --- Returns the unit vector from the scene towards the sun, the same as SunDirection.
    function GetSunDirection(self): Vector3
    --- Returns the unit vector from the scene towards the moon, which is always opposite the sun.
    function GetMoonDirection(self): Vector3
end

--- Storage for things both the server and players need, such as shared modules and assets. Nothing here is drawn or run.
declare extern type ReplicatedStorage extends Instance with
end

--- The engine's frame loop, seen from scripts: events that fire every frame, and whether the game runs in Studio, on a client or on the server. Get it with game:GetService("RunService").
declare extern type RunService extends Instance with
    --- Set by the engine when the game runs inside Studio. Read it with IsStudio().
    read InStudio: boolean
    --- Set by the engine while the game runs (paused included). Read it with IsRunning().
    read Running: boolean
    --- Set by the engine when this side is a player's client. Read it with IsClient().
    read OnClient: boolean
    --- Set by the engine when this side is the server. Read it with IsServer().
    read OnServer: boolean
    --- Fires every frame before the frame is drawn, before physics, with the frame's time step in seconds. Only on clients; a server never fires it. Use it for the camera and other things that must match what is drawn.
    RenderStepped: ScriptSignal<number>
    --- Fires every frame just before physics steps, with the frame's time step in seconds. Use it to move things physics should see this frame.
    PreSimulation: ScriptSignal<number>
    --- Fires every frame just after physics has stepped, with the frame's time step in seconds. Use it to read where physics put things.
    PostSimulation: ScriptSignal<number>
    --- Fires every frame at its end, after physics, with the frame's time step in seconds. Threads waiting in task.wait resume in the same step.
    Heartbeat: ScriptSignal<number>
    --- Returns true when the game runs inside Studio (in play mode or while editing).
    function IsStudio(self): boolean
    --- Returns true while the game runs: after it starts and until it stops. A paused game still runs.
    function IsRunning(self): boolean
    --- Returns true on a player's client. A standalone game, with no separate server, is both client and server.
    function IsClient(self): boolean
    --- Returns true on the server. A standalone game, with no separate server, is both client and server.
    function IsServer(self): boolean
end

--- Holds the game's server scripts. Scripts placed here run on the server; players never see them.
declare extern type ServerScriptService extends Instance with
end

--- Storage only the server can see, such as maps and items to copy into the world later. Nothing here is drawn or run.
declare extern type ServerStorage extends Instance with
end

--- The base of every script: an instance that points at a source file in the project. The file's extension selects the language, so a game can mix languages.
declare extern type SourceContainer extends Instance with
    --- The project-relative path of the script's source file, such as "Scripts/Door.luau", chosen with a file picker. The file's extension selects the language. Empty means the script has no source and does nothing.
    Source: string
end

--- The player's graphics settings: the preset, the quality level it draws at and the values in effect. Scripts can read them, to adapt a game to the player's machine, but never change them: they are the player's. Get it with game:GetService("UserGameSettings").
declare extern type UserGameSettings extends Instance with
    --- The graphics preset the player chose.
    read GraphicsPreset: EnumGraphicsPreset
    --- The quality level drawn at, from 1 (Low) to 4 (Ultra). With the Auto preset, the level its calibration chose for this machine.
    read QualityLevel: number
    --- The share of the window's width and height the scene is drawn at before it is scaled to the window (0.5 to 2). With dynamic resolution, the highest scale it may use.
    read RenderScale: number
    --- Whether the render scale changes every frame to hold the GPU frame time at TargetFrameTime.
    read DynamicResolution: boolean
    --- The GPU frame time dynamic resolution holds, in milliseconds.
    read TargetFrameTime: number
    --- How far the camera sees, in metres; 0 when it sees without limit.
    read ViewDistance: number
    --- The quality of the sun's shadows, from 1 (Low) to 4 (Ultra): how many shadow maps, how sharp.
    read ShadowQualityLevel: number
    --- How far from the camera the sun's shadows reach, in metres.
    read ShadowDistance: number
    --- How many point and spot lights a frame draws at full strength, the most important ones; the others fade out.
    read LocalLightBudget: number
    --- How finely distant round parts are drawn: 1 keeps their outlines within half a pixel; higher is finer.
    read LodBias: number
    --- Whether frames wait for the display's refresh.
    read VSync: boolean
    --- The most frames per second; 0 when uncapped.
    read FrameRateCap: number
    --- How edges are smoothed, as drawn on this machine.
    read AntiAliasing: EnumAntiAliasingMode
    --- The post effects' quality, from 1 (Low) to 4 (Ultra): how finely bloom is drawn. Bloom is drawn at every level.
    read EffectQualityLevel: number
end

--- Keyboard, mouse and touch input: events for every key, button, movement and touch, what is held right now, and how the mouse cursor behaves. Input arrives at the start of each frame. Get it with game:GetService("UserInputService").
declare extern type UserInputService extends Instance with
    --- How the cursor behaves. Default leaves it free; LockCenter holds it at the window's centre and LockCurrentPosition where it was when set, so mouse movement can turn a camera (read GetMouseDelta).
    MouseBehavior: EnumMouseBehavior
    --- Whether the cursor is shown over the game's window.
    MouseIconEnabled: boolean
    --- Whether a mouse is in use. Set by the engine once mouse input arrives.
    read MouseEnabled: boolean
    --- Whether a keyboard is in use. Set by the engine once keyboard input arrives.
    read KeyboardEnabled: boolean
    --- Whether a touch screen is in use. Set by the engine once a touch arrives.
    read TouchEnabled: boolean
    --- Whether a gamepad is connected. Set by the engine as gamepads come and go.
    read GamepadEnabled: boolean
    --- Engine bookkeeping: where the cursor is. Read it with GetMouseLocation().
    read MouseLocation: Vector2
    --- Engine bookkeeping: how far the mouse moved this frame. Read it with GetMouseDelta().
    read MouseDelta: Vector2
    --- Engine bookkeeping: held keys 0 to 63, as bits by KeyCode item index. Read them with IsKeyDown().
    read HeldKeys1: number
    --- Engine bookkeeping: held keys 64 to 127, as bits by KeyCode item index. Read them with IsKeyDown().
    read HeldKeys2: number
    --- Engine bookkeeping: held keys 128 to 191, as bits by KeyCode item index. Read them with IsKeyDown().
    read HeldKeys3: number
    --- Engine bookkeeping: held mouse buttons as bits (1 is MouseButton1). Read them with IsMouseButtonPressed().
    read HeldButtons: number
    --- Engine bookkeeping: the first input object of the held keys, each pointing to the next. Read them with GetKeysPressed().
    read FirstInput: InputObject?
    --- Fires when an input begins: a key or mouse button goes down, a finger touches the screen. Each press gets a new InputObject, which InputChanged and InputEnded pass again for that press. gameProcessedEvent is true when the game's UI used the input (always false until there is game UI).
    InputBegan: ScriptSignal<InputObject, boolean>
    --- Fires when an input changes: the mouse moves (once per frame, with the frame's movement as Delta), the wheel turns, a finger moves (once per frame per finger).
    InputChanged: ScriptSignal<InputObject, boolean>
    --- Fires when an input ends: a key or mouse button is released, a finger leaves the screen, or the window loses focus while it is held. A press shorter than a frame ends in the next frame, so InputBegan always sees it begun.
    InputEnded: ScriptSignal<InputObject, boolean>
    --- Fires when the game's window gains keyboard focus.
    WindowFocused: ScriptSignal<>
    --- Fires when the game's window loses keyboard focus.
    WindowFocusReleased: ScriptSignal<>
    --- Returns true while the key is held down. A key pressed and released within one frame is down for that frame.
    function IsKeyDown(self, keyCode: EnumKeyCode): boolean
    --- Returns true while the mouse button (UserInputType.MouseButton1, 2 or 3) is held down; false for any other input type.
    function IsMouseButtonPressed(self, mouseButton: EnumUserInputType): boolean
    --- Returns where the cursor is, in physical pixels from the window's top-left corner.
    function GetMouseLocation(self): Vector2
    --- Returns how far the mouse moved during this frame, in raw mouse units (X right, Y down). It keeps counting while the cursor is locked (MouseBehavior), which is what a camera reads; it is zero in a frame without movement.
    function GetMouseDelta(self): Vector2
    --- Returns the input objects of every key held down right now: the same objects InputBegan passed for those presses, and InputEnded will pass.
    function GetKeysPressed(self): {InputObject}
end

--- The base of the value objects: instances that store one value, such as a score or a door's target, where scripts can share it.
declare extern type ValueBase extends Instance with
    --- Fires after Value changes, with the new value.
    Changed: ScriptSignal<any>
end

--- The 3D world: everything placed here is part of the scene. Scripts placed here run.
declare extern type Workspace extends Instance with
    --- The camera the screen shows. A new game starts with one, named Camera, inside Workspace.
    CurrentCamera: Camera?
end

--- The base of everything that has a position in the 3D world, such as models, parts, lights and cameras.
declare extern type WorldObject extends Instance with
    --- Where the object's pivot sits, relative to the object. Moving and rotating the object happens around its pivot.
    PivotOffset: CFrame
    --- Returns the point the object moves and rotates around, as a CFrame in world space. For a model without a PrimaryPart it is the centre of its parts.
    function GetPivot(self): CFrame
    --- Moves the object so that its pivot is at the given CFrame. A model moves everything in it together, keeping their positions relative to each other.
    function PivotTo(self, targetCFrame: CFrame): ()
end

--- The base of every solid object in the world: where it is, how big, what it looks like and how it behaves.
declare extern type BasePart extends WorldObject with
    --- Where the part is and how it is rotated, in world space. Position and Orientation are views of it.
    CFrame: CFrame
    --- Where the part's centre is, in metres. Setting it moves the part without rotating it.
    Position: Vector3
    --- The part's rotation as angles in degrees about X, Y and Z, applied Z first, then X, then Y. Setting it rotates the part in place.
    Orientation: Vector3
    --- How big the part is along X, Y and Z, in metres. Each side is kept between 0.001 and 2048.
    Size: Vector3
    --- The part's colour.
    Color: Color3
    --- What the part looks like it is made of, such as Wood, Metal or Neon.
    Material: EnumMaterial
    --- How see-through the part is: 0 is solid, 1 is invisible.
    Transparency: number
    --- Whether the part casts a shadow.
    CastShadow: boolean
    --- Whether the part stays where it is. An anchored part is not moved by gravity or collisions.
    Anchored: boolean
    --- Whether other parts bump into this one. When off, things pass through it.
    CanCollide: boolean
end

--- The base of Script and LocalScript: a script that runs on its own when the game starts, if enabled.
declare extern type BaseScript extends SourceContainer with
    --- Whether the script runs. A disabled script does not start; turning it off later stops it.
    Enabled: boolean
end

--- Stores true or false under a name, such as whether a door is open.
declare extern type BoolValue extends ValueBase with
    --- The stored true or false. Starts false.
    Value: boolean
    --- Fires after Value changes, with the new value.
    Changed: ScriptSignal<boolean>
end

--- A point of view on the world. The screen shows what Workspace.CurrentCamera sees.
declare extern type Camera extends WorldObject with
    --- Where the camera is and which way it looks, in world space. It looks along its forward direction (-Z).
    CFrame: CFrame
    --- How much the camera sees from top to bottom, in degrees. Smaller values zoom in.
    FieldOfView: number
end

--- Stores a whole number under a name, such as a score or a count.
declare extern type IntValue extends ValueBase with
    --- The stored whole number. Starts at 0.
    Value: number
    --- Fires after Value changes, with the new value.
    Changed: ScriptSignal<number>
end

--- The base of every light: whether it is on, how bright, what colour, how far it reaches and shadows.
declare extern type Light extends WorldObject with
    --- Whether the light shines. Turning it off keeps every other setting.
    Enabled: boolean
    --- How strong the light is. 1 is an ordinary lamp; 0 gives no light; there is no upper limit.
    Brightness: number
    --- The colour of the light.
    Color: Color3
    --- How far the light reaches, in metres. Past this distance it lights nothing.
    Range: number
    --- Whether objects block this light and cast shadows. Shadows cost performance, so use them sparingly.
    Shadows: boolean
    --- Where the light is and which way it points (forward is -Z). Inside a part it is relative to the part, so the light moves with it; anywhere else it is in world space.
    CFrame: CFrame
end

--- A group of world objects that belong together, such as a car or a house, moved and copied as one.
declare extern type Model extends WorldObject with
    --- The part the model moves and rotates around. When it is nil (or not inside the model), the model pivots on its WorldPivot.
    PrimaryPart: BasePart?
    --- Where the model moves and rotates around when it has no PrimaryPart. Until it is first set (by PivotTo, Studio's tools or a script) it is the centre of the model's parts; from then on it is kept, turning with the model.
    WorldPivot: CFrame
    --- Where WorldPivot is kept once set.
    WorldPivotData: CFrame
    --- Whether WorldPivot was ever set; until it is, it is the centre of the model's parts.
    WorldPivotSet: boolean
    --- Where the model's pivot is, in metres. Setting it moves the whole model without rotating it.
    Position: Vector3
    --- The model's rotation about its pivot, as angles in degrees about X, Y and Z, applied Z first, then X, then Y. Setting it turns the whole model in place.
    Rotation: Vector3
    --- How big the model is against its size when made, one number for all three axes: 2 is twice as big. Setting it resizes everything in the model about its pivot.
    Scale: number
    --- Where Scale is kept.
    ScaleData: number
end

--- Code shared between scripts. It runs the first time a script requires it and returns a value, usually a table of functions; later requires return that same value.
declare extern type ModuleScript extends SourceContainer with
end

--- Stores a number under a name, such as a speed or an amount of health.
declare extern type NumberValue extends ValueBase with
    --- The stored number. Starts at 0.
    Value: number
    --- Fires after Value changes, with the new value.
    Changed: ScriptSignal<number>
end

--- Stores a reference to another instance under a name, such as the door a button opens.
declare extern type ObjectValue extends ValueBase with
    --- The instance it points at, or nil. Starts nil, and reads nil once that instance is destroyed.
    Value: Instance?
    --- Fires after Value changes, with the new value.
    Changed: ScriptSignal<Instance?>
end

--- Stores text under a name, such as a team name or a message to show.
declare extern type StringValue extends ValueBase with
    --- The stored text. Starts empty.
    Value: string
    --- Fires after Value changes, with the new value.
    Changed: ScriptSignal<string>
end

--- A script that runs on each player's client, for input, the camera and the user interface. What it changes is seen only by that player.
declare extern type LocalScript extends BaseScript with
end

--- A part drawn as an imported mesh with a texture, which you size, colour and place like any part.
declare extern type MeshPart extends BasePart with
    --- The id of the project's mesh asset (a glTF or GLB model) the part is drawn as. Its bounds are stretched to the part's Size. Empty draws nothing.
    MeshId: string
    --- The id of the project's image asset (PNG or JPEG) the mesh is coloured with, multiplied by Color. Empty uses Color alone.
    TextureId: string
end

--- The basic building block: a block, ball, cylinder or wedge that you size, colour and place.
declare extern type Part extends BasePart with
    --- The part's shape, stretched to its Size: a Ball whose sides differ is an ellipsoid; a Cylinder runs along X, its ends the ellipse of the Y and Z sizes; a Wedge slopes down towards -Z.
    Shape: EnumPartShape
end

--- Light shining in every direction from one point, like a bulb or a torch. It reaches Range metres.
declare extern type PointLight extends Light with
end

--- A script that runs on the server, where it can change the game for every player. In a standalone game, which has no separate server, it runs in the single local context.
declare extern type Script extends BaseScript with
end

--- A cone of light shining forward from the light, like a torch or a stage light.
declare extern type SpotLight extends Light with
    --- How wide the cone is: the full angle from one edge to the other, in degrees, up to 180 (a half sphere).
    Angle: number
end

--- Creates instances: `Instance.new("Part", workspace)`.
declare Instance: {
    new: ((className: "BindableEvent", parent: Instance?) -> BindableEvent)
        & ((className: "BindableFunction", parent: Instance?) -> BindableFunction)
        & ((className: "Folder", parent: Instance?) -> Folder)
        & ((className: "BoolValue", parent: Instance?) -> BoolValue)
        & ((className: "Camera", parent: Instance?) -> Camera)
        & ((className: "IntValue", parent: Instance?) -> IntValue)
        & ((className: "Model", parent: Instance?) -> Model)
        & ((className: "ModuleScript", parent: Instance?) -> ModuleScript)
        & ((className: "NumberValue", parent: Instance?) -> NumberValue)
        & ((className: "ObjectValue", parent: Instance?) -> ObjectValue)
        & ((className: "StringValue", parent: Instance?) -> StringValue)
        & ((className: "LocalScript", parent: Instance?) -> LocalScript)
        & ((className: "MeshPart", parent: Instance?) -> MeshPart)
        & ((className: "Part", parent: Instance?) -> Part)
        & ((className: "PointLight", parent: Instance?) -> PointLight)
        & ((className: "Script", parent: Instance?) -> Script)
        & ((className: "SpotLight", parent: Instance?) -> SpotLight),
}
