// Retro 32-bit: PS1. Vertex snapping, affine UVs, Gouraud light, vertex fog, 15-bit colour with dither.
(
    format: "metallic.look",
    version: 1,
    id: "retro-32",
    name: "Retro 32-bit",
    base: None,
    dimension: ThreeD,
    shading: (
        default: Retro(affine: 1.0, vertex_lighting: true, alpha_cutoff: 0.5),
        classes: {},
        materials: {
            "Glass": Retro(affine: 1.0, vertex_lighting: true, alpha_cutoff: 0.0),
        },
    ),
    lighting: (
        preset: "Clear Day",
        also_good: ["Horror Fog", "Golden Hour", "Overcast", "Moonlit", "Underwater"],
        style: Realistic,
        shadows: Blob,
        softness_min: 0.0,
        ambient_scale: 1.0,
        ao: Off,
        volumetrics: Off,
    ),
    exposure: (mode: Fixed, compensation: 0.0),
    tonemap: Clamp,
    outlines: (hull: Off, edges: Off),
    hdr: [],
    grade: (contrast: 0.0, saturation: 0.0, brightness: 0.0, tint: Rgb(255, 255, 255), lut: None, lut_strength: 0.0, vignette: 0.0),
    ldr: [],
    palette: Levels(levels: 32, dither: Bayer4, strength: 1.0),
    render: (scale: PixelHeight(240), upscale: Nearest, snap: Vertex, subpixel: false, aa: Off, detail_texels_per_stud: 4),
    output: [],
    fog: (mode: Vertex(start: 40.0, end: 200.0), density_scale: 1.0, color: Sky),
    tiers: {},
)
