// Pixel 3D: t3ssel8r-style 3D pixel art. Low-res target, 1 px edges, light in 1 EV steps, 32-colour palette.
(
    format: "metallic.look",
    version: 1,
    id: "pixel-3d",
    name: "Pixel 3D",
    base: None,
    dimension: ThreeD,
    shading: (
        default: Toon(bands: 3, softness: 0.0, shadow_tint: Rgb(215, 205, 255), flatten: 0.85, spec_size: 0.06, spec_strength: 0.6, rim_width: 0.0, rim_color: Rgb(255, 255, 255), light_step_ev: 1.0),
        classes: {},
        materials: {},
    ),
    lighting: (
        preset: "Pixel Dusk",
        also_good: ["Clear Day", "Golden Hour", "Moonlit", "Night City"],
        style: Soft,
        shadows: Hard,
        softness_min: 0.0,
        ambient_scale: 1.0,
        ao: Off,
        volumetrics: Off,
    ),
    exposure: (mode: Fixed, compensation: 0.0),
    tonemap: Neutral,
    outlines: (
        hull: Off,
        edges: On(mode: All, width_px: 1.0, color: Rgb(28, 24, 36), strength: 1.0, depth_threshold: 0.05, normal_threshold: 0.3, highlight: 0.5, wobble_px: 0.0),
    ),
    hdr: [],
    grade: (contrast: 0.0, saturation: 0.1, brightness: 0.0, tint: Rgb(255, 255, 255), lut: None, lut_strength: 0.0, vignette: 0.0),
    ldr: [],
    palette: Auto(size: 32, dither: Bayer4, strength: 0.4),
    render: (scale: PixelHeight(270), upscale: Sharp, snap: Texel, subpixel: true, aa: Off, detail_texels_per_stud: 0),
    output: [],
    fog: (mode: Height, density_scale: 0.8, color: Sky),
    tiers: {},
)
