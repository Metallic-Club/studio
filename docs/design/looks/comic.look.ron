// Comic: one hard band, thick post edges, halftone dots in the light falloff, hatching in shadow.
(
    format: "metallic.look",
    version: 1,
    id: "comic",
    name: "Comic",
    base: None,
    dimension: ThreeD,
    shading: (
        default: Toon(bands: 1, softness: 0.02, shadow_tint: Rgb(205, 210, 255), flatten: 0.9, spec_size: 0.1, spec_strength: 0.8, rim_width: 0.0, rim_color: Rgb(255, 255, 255), light_step_ev: 0.0),
        classes: {},
        materials: {
            "Glass": Lit(wrap: 0.3, roughness_floor: 0.0),
        },
    ),
    lighting: (
        preset: "Cartoon Bright",
        also_good: ["Clear Day", "Golden Hour", "Night City"],
        style: Soft,
        shadows: Tent,
        softness_min: 0.0,
        ambient_scale: 1.0,
        ao: PatternOnly,
        volumetrics: Off,
    ),
    exposure: (mode: Auto, compensation: 0.0),
    tonemap: Neutral,
    outlines: (
        hull: Off,
        edges: On(mode: All, width_px: 2.0, color: Rgb(26, 24, 32), strength: 1.0, depth_threshold: 0.05, normal_threshold: 0.3, highlight: 0.0, wobble_px: 0.0),
    ),
    hdr: [
        Bloom(intensity: 0.03, size: 24.0, threshold: 0.0),
    ],
    grade: (contrast: 0.1, saturation: 0.2, brightness: 0.0, tint: Rgb(255, 255, 255), lut: None, lut_strength: 0.0, vignette: 0.0),
    ldr: [
        Pattern(kind: Halftone, source: Luminance, from: 0.35, to: 0.65, cell_px: 6.0, angle: 45.0, ink: Rgb(26, 24, 32), strength: 0.5),
        Pattern(kind: Hatch, source: Shadow, from: 0.0, to: 1.0, cell_px: 5.0, angle: 45.0, ink: Rgb(26, 24, 32), strength: 0.6),
        Pattern(kind: Hatch, source: Ao, from: 0.0, to: 1.0, cell_px: 5.0, angle: -45.0, ink: Rgb(26, 24, 32), strength: 0.5),
    ],
    palette: Off,
    render: (scale: Relative(1.0), upscale: Bilinear, snap: Off, subpixel: false, aa: Msaa4, detail_texels_per_stud: 0),
    output: [],
    fog: (mode: Height, density_scale: 0.8, color: Sky),
    tiers: {
        Low: (aa: Some(Fxaa), ao: Some(Off)),
    },
)
