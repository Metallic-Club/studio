// HD-2D: lit 3D world, pixel sprites as billboards, tilt-shift depth of field, warm bloom.
(
    format: "metallic.look",
    version: 1,
    id: "hd-2d",
    name: "HD-2D",
    base: None,
    dimension: Mixed,
    shading: (
        default: Lit(wrap: 0.1, roughness_floor: 0.3),
        classes: {
            Sprite: LitSprite(filter: Nearest, alpha_cutoff: 0.5, normal_maps: true, billboard: YLocked, casts_shadows: true),
        },
        materials: {},
    ),
    lighting: (
        preset: "Golden Hour",
        also_good: ["Clear Day", "Overcast", "Moonlit", "Night City", "Horror Fog"],
        style: Realistic,
        shadows: Auto,
        softness_min: 0.2,
        ambient_scale: 1.0,
        ao: Darken(intensity: 1.0),
        volumetrics: Auto,
    ),
    exposure: (mode: Auto, compensation: 0.0),
    tonemap: AgXPunchy,
    outlines: (hull: Off, edges: Off),
    hdr: [
        Dof(mode: TiltShift, centre: 0.55, focus_band: 0.3, max_blur_px: 8.0),
        Bloom(intensity: 0.06, size: 32.0, threshold: 0.0),
    ],
    grade: (contrast: 0.05, saturation: 0.1, brightness: 0.0, tint: Rgb(255, 250, 242), lut: None, lut_strength: 0.0, vignette: 0.25),
    ldr: [],
    palette: Off,
    render: (scale: Relative(1.0), upscale: Bilinear, snap: Off, subpixel: false, aa: Auto, detail_texels_per_stud: 0),
    output: [],
    fog: (mode: Height, density_scale: 1.2, color: Sky),
    tiers: {
        Low: (ao: Some(Off), half_res: [Dof], replace: [Dof(mode: TiltShift, centre: 0.55, focus_band: 0.3, max_blur_px: 4.0)]),
        Medium: (half_res: [Dof]),
    },
)
