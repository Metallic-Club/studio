// Voxel (added by #144): flat shading with blocky material detail, 8 texels per stud, nearest filtering.
(
    format: "metallic.look",
    version: 1,
    id: "voxel",
    name: "Voxel",
    base: None,
    dimension: ThreeD,
    shading: (
        default: Flat(wrap: 0.0),
        classes: {},
        materials: {},
    ),
    lighting: (
        preset: "Clear Day",
        also_good: ["Golden Hour", "Overcast", "Moonlit", "Night City"],
        style: Realistic,
        shadows: Hard,
        softness_min: 0.0,
        ambient_scale: 1.0,
        ao: Darken(intensity: 0.8),
        volumetrics: Off,
    ),
    exposure: (mode: Auto, compensation: 0.0),
    tonemap: Neutral,
    outlines: (hull: Off, edges: Off),
    hdr: [
        Bloom(intensity: 0.02, size: 16.0, threshold: 0.0),
    ],
    grade: (contrast: 0.05, saturation: 0.05, brightness: 0.0, tint: Rgb(255, 255, 255), lut: None, lut_strength: 0.0, vignette: 0.1),
    ldr: [],
    palette: Off,
    render: (scale: Relative(1.0), upscale: Bilinear, snap: Off, subpixel: false, aa: Msaa4, detail_texels_per_stud: 8),
    output: [],
    fog: (mode: Height, density_scale: 1.2, color: Sky),
    tiers: {
        Low: (aa: Some(Fxaa)),
    },
)
