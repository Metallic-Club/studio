// Low-poly: faceted flat shading, strong height fog, clean colours.
(
    format: "metallic.look",
    version: 1,
    id: "low-poly",
    name: "Low-poly",
    base: None,
    dimension: ThreeD,
    shading: (
        default: Flat(wrap: 0.1),
        classes: {},
        materials: {},
    ),
    lighting: (
        preset: "Clear Day",
        also_good: ["Golden Hour", "Desert Noon", "Overcast", "Moonlit", "Alien Dusk"],
        style: Realistic,
        shadows: Tent,
        softness_min: 0.0,
        ambient_scale: 1.0,
        ao: Darken(intensity: 0.7),
        volumetrics: Off,
    ),
    exposure: (mode: Auto, compensation: 0.0),
    tonemap: Neutral,
    outlines: (hull: Off, edges: Off),
    hdr: [
        Bloom(intensity: 0.03, size: 24.0, threshold: 0.0),
    ],
    grade: (contrast: 0.0, saturation: 0.1, brightness: 0.0, tint: Rgb(255, 255, 255), lut: None, lut_strength: 0.0, vignette: 0.1),
    ldr: [],
    palette: Off,
    render: (scale: Relative(1.0), upscale: Bilinear, snap: Off, subpixel: false, aa: Msaa4, detail_texels_per_stud: 0),
    output: [],
    fog: (mode: Height, density_scale: 1.6, color: Sky),
    tiers: {
        Low: (aa: Some(Fxaa)),
    },
)
