// Toon: anime and cel shading. Two bands, tinted shadows, inverted-hull outlines.
(
    format: "metallic.look",
    version: 1,
    id: "toon",
    name: "Toon",
    base: None,
    dimension: ThreeD,
    shading: (
        default: Toon(bands: 2, softness: 0.03, shadow_tint: Rgb(230, 220, 255), flatten: 0.85, spec_size: 0.08, spec_strength: 0.5, rim_width: 0.0, rim_color: Rgb(255, 255, 255), light_step_ev: 0.0),
        classes: {
            Character: Toon(bands: 2, softness: 0.03, shadow_tint: Rgb(235, 210, 230), flatten: 0.85, spec_size: 0.06, spec_strength: 0.4, rim_width: 0.12, rim_color: Rgb(255, 250, 240), light_step_ev: 0.0),
        },
        materials: {
            "Metal": Toon(bands: 3, softness: 0.02, shadow_tint: Rgb(220, 220, 255), flatten: 0.85, spec_size: 0.2, spec_strength: 1.0, rim_width: 0.0, rim_color: Rgb(255, 255, 255), light_step_ev: 0.0),
            "Glass": Lit(wrap: 0.3, roughness_floor: 0.0),
        },
    ),
    lighting: (
        preset: "Cartoon Bright",
        also_good: ["Clear Day", "Golden Hour", "Moonlit", "Night City"],
        style: Soft,
        shadows: Tent,
        softness_min: 0.0,
        ambient_scale: 1.0,
        ao: Off,
        volumetrics: Off,
    ),
    exposure: (mode: Auto, compensation: 0.0),
    tonemap: Neutral,
    outlines: (
        hull: On(width_px: 2.0, color: Rgb(40, 36, 52), max_clip_width: 0.02),
        edges: On(mode: IntersectionsOnly, width_px: 1.0, color: Rgb(40, 36, 52), strength: 1.0, depth_threshold: 0.05, normal_threshold: 0.3, highlight: 0.0, wobble_px: 0.0),
    ),
    hdr: [
        Bloom(intensity: 0.03, size: 24.0, threshold: 0.0),
    ],
    grade: (contrast: 0.0, saturation: 0.1, brightness: 0.0, tint: Rgb(255, 255, 255), lut: None, lut_strength: 0.0, vignette: 0.0),
    ldr: [],
    palette: Off,
    render: (scale: Relative(1.0), upscale: Bilinear, snap: Off, subpixel: false, aa: Msaa4, detail_texels_per_stud: 0),
    output: [],
    fog: (mode: Height, density_scale: 0.8, color: Sky),
    tiers: {
        Low: (aa: Some(Fxaa), drop: [Edges]),
    },
)
