(
  format: 1,
  name: "Snow",
  description: "Gentle snowfall that settles on the ground.",
  tags: [
    "weather",
    "snow",
    "loop",
  ],
  style: Realistic,
  emitters: [
    (
      name: "Flakes",
      capacity: 1024,
      spawn: [
        Rate(
          per_second: 70.0,
        ),
      ],
      init: [
        Shape(
          shape: Box(
            size: (14.0, 0.1, 8.0),
          ),
          offset: (0.0, 8.0, 0.0),
        ),
        Lifetime(
          seconds: (8.0, 10.0),
        ),
        Velocity(
          speed: (0.8, 1.4),
          direction: Axis((-0.0, -1.0, -0.0)),
          spread: (10.0, 10.0),
        ),
        Size(
          size: (0.07, 0.17),
        ),
      ],
      update: [
        CurlNoise(
          strength: 1.2,
          scale: 3.0,
          scroll: (0.3, 0.0, 0.0),
          octaves: 2,
        ),
        CollisionPlane(
          point: (0.0, 0.0, 0.0),
          normal: (0.0, 1.0, 0.0),
          bounce: 0.0,
          friction: 1.0,
          on_hit: Stick,
        ),
        TransparencyOverLife(
          curve: (
            keys: [
              (0.0, 1.0),
              (0.08, 0.0),
              (0.9, 0.0),
              (1.0, 1.0),
            ],
            interp: Smooth,
          ),
        ),
      ],
      render: (
        kind: Billboard,
        texture: SoftDot,
      ),
    ),
  ],
)
