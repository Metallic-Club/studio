(
  format: 1,
  name: "Fountain",
  description: "A water fountain jet falling back into a pool.",
  tags: [
    "water",
    "loop",
    "environment",
  ],
  style: Realistic,
  emitters: [
    (
      name: "Jet",
      capacity: 512,
