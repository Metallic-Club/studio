          on_hit: Kill,
        ),
        TransparencyOverLife(
          curve: (
            keys: [
              (0.0, 0.1),
              (1.0, 0.4),
            ],
            interp: Smooth,
          ),
        ),
      ],
      render: (
        kind: Billboard,
        facing: VelocityParallel,
        texture: Droplet,
        light_emission: 0.3,
        brightness: 1.1,
      ),
    ),
    (
      name: "Spray",
      capacity: 256,
      spawn: [
        Rate(
          per_second: 30.0,
        ),
      ],
      init: [
        Shape(
          shape: Disc(
